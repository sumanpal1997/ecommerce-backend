# Production Environment Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.com

# MongoDB Atlas or Self-Hosted
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopflow_prod?retryWrites=true&w=majority

# Redis (Upstash, Redis Cloud, or Self-Hosted)
REDIS_URL=redis://default:<password>@<redis-host>:6379

# Cryptographic Keys (Minimum 32 random characters)
JWT_ACCESS_SECRET=replace_with_a_64_character_crypto_random_secret_string
JWT_REFRESH_SECRET=replace_with_another_64_character_crypto_random_secret_string
COOKIE_SECRET=replace_with_another_cookie_secret_string

# SMTP Production Mailer (Resend, SendGrid, Mailgun, AWS SES, Gmail)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=ShopFlow Studio <concierge@your-domain.com>
